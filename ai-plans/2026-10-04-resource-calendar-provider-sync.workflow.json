{
  "$schema": "https://github.com/vintasoftware/vinta-ai-workflows/schemas/workflow.v1.schema.json",
  "schema_version": 1,
  "id": "2026-10-04-resource-calendar-provider-sync",
  "plan_ref": "ai-plans/2026-10-04-RESOURCE_CALENDAR_PROVIDER_SYNC_IMPLEMENTATION_PLAN.md",
  "plan_context_refs": [
    "ai-plans/2026-10-04-RESOURCE_CALENDAR_PROVIDER_SYNC_IMPLEMENTATION_PLAN.md#1-goals",
    "ai-plans/2026-10-04-RESOURCE_CALENDAR_PROVIDER_SYNC_IMPLEMENTATION_PLAN.md#2-guiding-decisions"
  ],
  "base_branch": "feature/resource-calendar-provider-sync",
  "project": {
    "migrate_cmd": "docker compose run --rm api uv run python manage.py migrate",
    "databases": {
      "dev": {
        "engine": "postgres",
        "delivery": "compose",
        "name": "vinta_schedule_api",
        "server_url": "postgres://db:5432",
        "connection_url_var": "DATABASE_URL"
      }
    },
    "env_files": [
      ".env",
      ".env.docker",
      "vinta_schedule_api/settings/local.py"
    ]
  },
  "crew": {
    "tier4": {
      "role": "implementer",
      "tier": 4,
      "model": "claude-opus-5-5",
      "description": "Push retry protocol, provider-wins resync, booking-resolution apply engine."
    },
    "tier3-1": {
      "role": "implementer",
      "tier": 3,
      "model": "claude-opus-5-5",
      "description": "Schema and contracts, Google adapter, busy check, then the create/edit/delete surface chain."
    },
    "tier3-2": {
      "role": "implementer",
      "tier": 3,
      "model": "claude-opus-5-5",
      "description": "The Microsoft track: admin consent, app-only Places writes, room event delta sync and webhooks; plus the spike."
    },
    "tier2": {
      "role": "implementer",
      "tier": 2,
      "model": "claude-sonnet-5-5",
      "description": "Flag module, notifications, admin, DI wiring, flagged-bookings surface, flag removal."
    },
    "reviewer-1": {
      "role": "reviewer",
      "tier": 3,
      "model": "claude-opus-5-5",
      "description": "Reviews the Tier 2 and Tier 3 phases."
    },
    "reviewer-2": {
      "role": "reviewer",
      "tier": 4,
      "model": "claude-opus-5-5",
      "description": "Reviews the Tier 4 phases and the Tier 4 review overrides (Phases 2, 5, 9)."
    }
  },
  "defaults": {
    "harness": "claude-code",
    "model": "claude-opus-5-5",
    "pipeline": "standard-phase"
  },
  "resources": {
    "lane": {
      "capacity": 4,
      "kind": "worktree",
      "description": "One desk per implementer, kept for the whole run."
    },
    "test-suite": {
      "capacity": 1,
      "kind": "semaphore",
      "description": "The full pytest -n auto suite saturates every core; two at once slow both."
    }
  },
  "gates": {
    "lint": {
      "cmd": "docker compose run --rm -T api sh -c 'uv run ruff check ./ && uv run ruff format --check ./'",
      "requires": [],
      "timeout_s": 900,
      "description": "ruff lint and format check, inside the lane's Compose stack."
    },
    "typecheck": {
      "cmd": "docker compose run --rm -T api sh -c 'uv run mypy . && uv run python manage.py check --deploy && uv run python manage.py makemigrations --check --dry-run'",
      "requires": [],
      "timeout_s": 1800,
      "description": "mypy, Django deploy checks and missing-migration check, inside the lane's Compose stack."
    },
    "test": {
      "cmd": "docker compose run --rm -T api uv run pytest --reuse-db -n auto --no-cov",
      "requires": [
        "test-suite"
      ],
      "timeout_s": 3600,
      "description": "The full suite against the lane's own database, one lane at a time."
    }
  },
