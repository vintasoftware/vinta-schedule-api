      ],
      "prompt_ref": "ai-plans/2026-10-09-DI_CONTAINER_SPLIT_IMPLEMENTATION_PLAN.md#phase-6",
      "touches": [
        "di_core/containers.py",
        "webhooks/containers.py",
        "webhooks/tests/test_containers.py"
      ],
      "crew": "tier1-2"
    },
    {
      "id": "p7",
      "name": "Move public API providers",
      "depends_on": [
        {
          "node": "p2",
          "artifact": "`AuditContainer.audit_service`"
        },
        {
          "node": "p4",
          "artifact": "`BillingContainer.entitlement_service`"
        }
      ],
      "prompt_ref": "ai-plans/2026-10-09-DI_CONTAINER_SPLIT_IMPLEMENTATION_PLAN.md#phase-7",
      "touches": [
        "di_core/containers.py",
        "public_api/containers.py",
        "public_api/tests/test_containers.py"
      ],
      "crew": "tier1-1"
    },
    {
      "id": "p8",
      "name": "Move calendar providers",
      "depends_on": [
        {
          "node": "p2",
          "artifact": "`AuditContainer.audit_service`"
        },
        {
          "node": "p3",
          "artifact": "`NotificationsContainer.notification_service`"
        },
        {
          "node": "p4",
          "artifact": "`BillingContainer.entitlement_service`"
        },
        {
          "node": "p6",
          "artifact": "`WebhooksContainer.webhook_calendar_side_effects_service`"
        }
      ],
      "prompt_ref": "ai-plans/2026-10-09-DI_CONTAINER_SPLIT_IMPLEMENTATION_PLAN.md#phase-8",
      "touches": [
        "di_core/containers.py",
        "calendar_integration/containers.py",
        "calendar_integration/tests/test_containers.py"
      ],
      "crew": "tier2"
    },
    {
      "id": "p9",
      "name": "Move organization providers",
      "depends_on": [
        {
          "node": "p2",
          "artifact": "`AuditContainer.audit_service`"
        },
        {
          "node": "p4",
          "artifact": "`BillingContainer.subscription_service` and `entitlement_service`"
        },
        {
          "node": "p6",
          "artifact": "`WebhooksContainer.webhook_membership_side_effects_service`"
        },
        {
          "node": "p8",
          "artifact": "`CalendarContainer.calendar_service`"
        }
      ],
      "prompt_ref": "ai-plans/2026-10-09-DI_CONTAINER_SPLIT_IMPLEMENTATION_PLAN.md#phase-9",
      "touches": [
        "di_core/containers.py",
        "organizations/containers.py",
        "organizations/tests/test_containers.py"
      ],
      "crew": "tier2"
    },
    {
      "id": "p10",
      "name": "Remove aliases, add guard test and docs",
      "depends_on": [
        {
          "node": "p2",
          "artifact": "the alias lines the moved providers left in `di_core/containers.py`"
        },
        {
          "node": "p3",
          "artifact": "the alias lines the moved providers left in `di_core/containers.py`"
        },
        {
          "node": "p4",
          "artifact": "the alias lines the moved providers left in `di_core/containers.py`"
        },
        {
          "node": "p5",
          "artifact": "the alias lines the moved providers left in `di_core/containers.py`"
        },
        {
          "node": "p6",
          "artifact": "the alias lines the moved providers left in `di_core/containers.py`"
        },
        {
          "node": "p7",
          "artifact": "the alias lines the moved providers left in `di_core/containers.py`"
        },
        {
          "node": "p8",
          "artifact": "the alias lines the moved providers left in `di_core/containers.py`"
        },
        {
          "node": "p9",
          "artifact": "the alias lines the moved providers left in `di_core/containers.py`"
        }
      ],
      "prompt_ref": "ai-plans/2026-10-09-DI_CONTAINER_SPLIT_IMPLEMENTATION_PLAN.md#phase-10",
      "touches": [
        "di_core/containers.py",
        "di_core/tests/test_container_composition.py",
        "AGENTS.md",
        "organizations/models.py"
      ],
      "crew": "tier2"
    }
  ]
}
