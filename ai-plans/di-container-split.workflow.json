        }
      ],
      "prompt_ref": "ai-plans/2026-10-09-DI_CONTAINER_SPLIT_IMPLEMENTATION_PLAN.md#phase-5",
      "touches": [
        "di_core/containers.py",
        "legal/containers.py",
        "legal/tests/test_containers.py"
      ],
      "crew": "tier1-1"
    },
    {
      "id": "p6",
      "name": "Move webhook providers",
      "depends_on": [
        {
          "node": "p4",
          "artifact": "`BillingContainer.entitlement_service`, taken by `webhook_service`"
