# Container env: used by docker-compose (env_file: .env.docker).
# Service hostnames point at the compose service names.
# Copy to .env.docker.
DJANGO_SETTINGS_MODULE=vinta_schedule_api.settings.local
# Celery brokers over SQS, emulated locally by Floci -- the same transport the
# deployed environments use, so at-least-once delivery, redelivery when the
# visibility timeout lapses and the dead-letter queue all behave the same here.
# The credentials are Floci's fixed test/test pair; kombu reads the endpoint off
# this URL's host and port.
CELERY_BROKER_URL=sqs://test:test@floci:4566
# Floci serves plain HTTP; against real SQS this stays unset (defaults to true).
CELERY_SQS_IS_SECURE=false
# Created by `make setup` (scripts/init_floci.py), which prints both forms of the
# URL. Naming it keeps kombu from calling ListQueues to discover it.
CELERY_TASK_DEFAULT_QUEUE=vinta-schedule-local-celery
CELERY_SQS_QUEUE_URL=http://floci:4566/000000000000/vinta-schedule-local-celery
# Shorter than the 900s the deployed queues use, so a failed task comes back
# within a minute instead of a quarter of an hour. The same value configures the
# queue, so re-run `make setup` after changing it.
CELERY_SQS_VISIBILITY_TIMEOUT=60
# Tasks run in-process by default. Flip to false to publish to Floci for real and
# let the `worker` container pick them up.
CELERY_TASK_ALWAYS_EAGER=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# SPA/dashboard base URL. Used as the post-authentication fallback destination
# (accounts/views.py) when the acting organization has no configured branding
# redirect_url. Reached from the host, like CORS_ALLOWED_ORIGINS above.
FRONTEND_BASE_URL=http://localhost:3000
# From address on every outbound email. NOTIFICATION_DEFAULT_FROM_EMAIL (vintasend's
# notifications) falls back to DEFAULT_FROM_EMAIL (Django's own mail, e.g. allauth's
# password reset), so setting only the first keeps the two senders in agreement.
DEFAULT_FROM_EMAIL=noreply@localhost
REDIS_URL=redis://result:6379
DATABASE_URL=postgres://vinta_schedule_api:password@db:5432/vinta_schedule_api
FLOCI_ENDPOINT=http://floci:4566
FLOCI_EXTERNAL_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=vinta_schedule
PYTHONBREAKPOINT=ipdb.set_trace
SALT_KEY=TEST_SALT_KEY_123
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
# Preferred: API Key auth. Set both. Falls back to TWILIO_AUTH_TOKEN if unset.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Legacy auth-token auth (not recommended). Used only if API key vars are unset.
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
TWILIO_DEFAULT_BROADCAST_NUMBERS=
# Per-environment rollout gate for SMS phone verification. Keep False until
# Twilio approves the messaging profile for this environment.
ACCOUNT_PHONE_VERIFICATION_ENABLED=False
# Secret API key used to authenticate every outbound MercadoPago call
# (charges, refunds, status polls, subscriptions). This -- not
# MERCADOPAGO_PUBLIC_KEY -- is what decides whether MercadoPago can actually be
# charged through: see MercadoPagoPaymentAdapter.is_configured.
MERCADOPAGO_ACCESS_TOKEN=CHANGEME
# Shared secret used to verify MercadoPago's `x-signature` webhook header. A
# guessable default (e.g. "test") would give local signature verification a
# working secret an attacker can trivially replicate; CHANGEME fails closed
# instead, matching the empty default in settings/base.py.
MERCADOPAGO_WEBHOOK_SECRET=CHANGEME
# Browser-safe public key for MercadoPago checkout form. Not a secret and
# intentionally not isolated — served on unauthenticated endpoints.
MERCADOPAGO_PUBLIC_KEY=
# Stripe secret API key. No organization is routed onto Stripe yet, so this is
# unused in practice until Phase 9 — CHANGEME is a safe placeholder either way.
STRIPE_SECRET_KEY=CHANGEME
# Shared secret used to verify Stripe's `Stripe-Signature` webhook header. Same
# fail-closed rationale as MERCADOPAGO_WEBHOOK_SECRET, above.
STRIPE_WEBHOOK_SECRET=CHANGEME
# Browser-safe public key for Stripe checkout form. Not a secret and intentionally
# not isolated — served on unauthenticated endpoints.
STRIPE_PUBLISHABLE_KEY=
# System default payment provider. Must be one of: stripe, mercadopago.
DEFAULT_PAYMENT_PROVIDER=stripe
# Global fallback grace window (days) between a failed recurring charge and an
# organization moving from GRACE to RESTRICTED, used when the subscription's
# plan carries no grace_period_days of its own. Tunable per environment with no
# code change.
BILLING_DEFAULT_GRACE_PERIOD_DAYS=7

# ---------------------------------------------------------------------------
# Deployed environments only. ECS supplies these from the task definition or the
# Secrets Manager secret (see infrastructure/modules/app-platform), so none of them
# belongs in a local .env -- unlike the CELERY_SQS_* vars above, which local dev
# does set, because Floci needs them. Listed here so the full set of variables the
# app reads stays discoverable from one file.
#
#   CELERY_SQS_WAIT_TIME_SECONDS    # long-poll window, 0-20
#   CELERY_SQS_POLLING_INTERVAL     # seconds between polls
#   CELERY_WORKER_MAX_MEMORY_PER_CHILD  # KB; retires a leaking prefork child
#   COMMIT_SHA                      # release tag reported to Sentry
#   ECS_CONTAINER_METADATA_URI_V4   # set by ECS itself; the task's own IP is
#                                   # appended to ALLOWED_HOSTS so the load
#                                   # balancer health check is not a 400
# ---------------------------------------------------------------------------
