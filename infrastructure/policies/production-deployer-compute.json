{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcsClusterAndServices",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateCluster",
        "ecs:DeleteCluster",
        "ecs:PutClusterCapacityProviders",
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": [
        "arn:aws:ecs:us-east-1:261390480437:cluster/vinta-schedule-production",
        "arn:aws:ecs:us-east-1:261390480437:service/vinta-schedule-production/vinta-schedule-production-*",
        "arn:aws:ecs:us-east-1:261390480437:task-definition/vinta-schedule-production-*:*"
      ]
    },
    {
      "Sid": "EcsTaskDefinitions",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DeregisterTaskDefinition"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "EcrRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DeleteRepository",
        "ecr:PutLifecyclePolicy",
        "ecr:DeleteLifecyclePolicy",
        "ecr:SetRepositoryPolicy",
        "ecr:DeleteRepositoryPolicy",
        "ecr:PutImageScanningConfiguration",
        "ecr:PutImageTagMutability",
        "ecr:TagResource",
        "ecr:UntagResource"
      ],
      "Resource": "arn:aws:ecr:us-east-1:261390480437:repository/vinta-schedule-production"
    },
    {
      "Sid": "RdsInstance",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance",
        "rds:DeleteDBInstance",
        "rds:ModifyDBInstance",
        "rds:CreateDBSubnetGroup",
        "rds:DeleteDBSubnetGroup",
        "rds:ModifyDBSubnetGroup",
        "rds:CreateDBParameterGroup",
        "rds:DeleteDBParameterGroup",
        "rds:ModifyDBParameterGroup",
        "rds:ResetDBParameterGroup",
        "rds:CreateDBSnapshot",
        "rds:AddTagsToResource",
        "rds:RemoveTagsFromResource"
      ],
      "Resource": [
        "arn:aws:rds:us-east-1:261390480437:db:vinta-schedule-production",
        "arn:aws:rds:us-east-1:261390480437:subgrp:vinta-schedule-production",
        "arn:aws:rds:us-east-1:261390480437:pg:vinta-schedule-production",
        "arn:aws:rds:us-east-1:261390480437:snapshot:vinta-schedule-production-*"
      ]
    },
    {
      "Sid": "ElastiCache",
      "Effect": "Allow",
      "Action": [
        "elasticache:CreateReplicationGroup",
        "elasticache:DeleteReplicationGroup",
        "elasticache:ModifyReplicationGroup",
        "elasticache:CreateCacheSubnetGroup",
        "elasticache:DeleteCacheSubnetGroup",
        "elasticache:ModifyCacheSubnetGroup",
        "elasticache:AddTagsToResource",
        "elasticache:RemoveTagsFromResource"
      ],
      "Resource": [
        "arn:aws:elasticache:us-east-1:261390480437:replicationgroup:vinta-schedule-production",
        "arn:aws:elasticache:us-east-1:261390480437:subnetgroup:vinta-schedule-production",
        "arn:aws:elasticache:us-east-1:261390480437:parametergroup:*"
      ]
    },
    {
      "Sid": "CloudWatchLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:TagLogGroup",
        "logs:UntagLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:261390480437:log-group:/ecs/vinta-schedule-production*",
        "arn:aws:logs:us-east-1:261390480437:log-group:/ecs/vinta-schedule-production*:*",
        "arn:aws:logs:us-east-1:261390480437:log-group:/aws/rds/instance/vinta-schedule-production/*",
        "arn:aws:logs:us-east-1:261390480437:log-group:/aws/rds/instance/vinta-schedule-production/*:*"
      ]
    },
    {
      "Sid": "ReadsThatDoNotScopeByArn",
      "Effect": "Allow",
      "Action": [
        "ecs:Describe*",
        "ecs:List*",
        "ecr:Describe*",
        "ecr:GetLifecyclePolicy",
        "ecr:GetRepositoryPolicy",
        "ecr:ListTagsForResource",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "elasticache:Describe*",
        "elasticache:ListTagsForResource",
        "logs:Describe*",
        "logs:ListTagsForResource",
        "logs:ListTagsLogGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}
